{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-forms-evolution": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@agorapulse/ui-theme/assets",
                "output": "./assets/lib-ui-theme"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@agorapulse/ui-symbol/assets",
                "output": "./assets/lib-ui-symbol"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@agorapulse/ui-animations/assets",
                "output": "./assets/lib-ui-animations"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/@agorapulse/ui-components/assets",
                "output": "./assets/lib-ui-components"
              }
            ],
            "styles": [
              "node_modules/@agorapulse/ui-theme/assets/style/theme.scss",
              "src/styles.scss",
              "node_modules/@agorapulse/ui-theme/assets/desktop_variables.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-forms-evolution:build:production"
            },
            "development": {
              "buildTarget": "angular-forms-evolution:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
